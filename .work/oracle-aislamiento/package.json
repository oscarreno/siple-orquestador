  "scripts": {
    "start": "node dist/index.js",
    "dist": "tsc && npm run copiarArchivos",
    "dev": "nodemon src/index.ts ts-node -e ts,graphql && npm run copiarArchivos",
    "copiarArchivos": "copyfiles --up 1 src/graphql/schema/* src/public/*.html dist",
    "validar:guardar-grupo": "node -r ts-node/register/transpile-only pruebas/validate-guardarGrupo.ts",
    "validar:bitacora-publica": "node -r ts-node/register/transpile-only pruebas/validate-bitacora-publica.ts",
    "validar:auditoria-servidor": "node -r ts-node/register/transpile-only pruebas/validate-auditoria-servidor.ts",
    "validar:oracle-transacciones": "node -r ts-node/register/transpile-only pruebas/validate-oracle-transacciones.ts",
    "validar:todas": "npm run validar:guardar-grupo && npm run validar:bitacora-publica && npm run validar:auditoria-servidor && npm run validar:oracle-transacciones"
  },
